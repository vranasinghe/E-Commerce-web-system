# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# ─────────────────────────────────────────────────────────────
# Cache (Redis)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# Auth (NextAuth.js)
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# AI — Anthropic Claude (chatbot + styling advice)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
# Groq (used as the chatbot provider when ANTHROPIC_API_KEY is unset)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Embeddings provider for recommendations / visual search
EMBEDDINGS_PROVIDER="openai"   # openai | clip
OPENAI_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Payments (Stripe — test mode)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─────────────────────────────────────────────────────────────
# Image storage (S3 / Cloudinary)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_URL=""
S3_BUCKET=""
S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────
# Service URLs (local dev)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
AI_SERVICE_URL="http://localhost:4100"
